{
  "name": "state-nj-seating",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "lint": "next lint",
    "postinstall": "node scripts/ensure-db-url.mjs npx prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --experimental-strip-types prisma/seed.ts",
    "db:prices": "node --experimental-strip-types scripts/update-prices.ts",
    "db:kills": "node --experimental-strip-types scripts/apply-kills.ts",
    "db:ada": "node --experimental-strip-types scripts/apply-ada.ts",
    "db:reset": "prisma db push --force-reset && node --experimental-strip-types prisma/seed.ts",
    "extract": ".venv/bin/python scripts/extract_excel.py"
  },
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "prisma": "^6.10.1",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "node --experimental-strip-types prisma/seed.ts"
  }
}
